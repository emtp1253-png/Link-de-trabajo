// Pricing.astro — Diseño nuevo (claro + elegante) con MercadoPago intacto
// Los botones hacen fetch POST a la API de Vercel y redirigen a MP Checkout
 
const API_URL = 'https://kreatu-api-1tdb.vercel.app/api/create_preference';
 
const planes = [
  {
    id:       'starter',
    name:     'Esencial',
    tag:      'Una sola página, lista para conectar.',
    price:    '$999',
    cents:    '.99',
    pago:     'MXN · pago único',
    featured: false,
    cta:      'Empezar con Esencial',
    features: [
      'Landing de una página',
      'Diseño a tu marca',
      'Formulario + WhatsApp',
      'Dominio el primer año',
      'SSL incluido',
      'Entrega en 7 días',
    ],
    mpTitle:  'Plan Starter KreatuSitioWeb',
    mpAmount: 999.99,
  },
  {
    id:       'pro',
    name:     'Profesional',
    tag:      'El sitio completo de tu consultorio o despacho.',
    price:    '$1,999',
    cents:    '.99',
    pago:     'MXN · pago único',
    featured: true,
    cta:      'Quiero Profesional',
    features: [
      'Hasta 5 secciones completas',
      'Servicios, blog y contacto',
      'SEO local optimizado',
      'Agenda en línea (Calendly)',
      'Editor para tu equipo',
      'Soporte 30 días',
    ],
    mpTitle:  'Plan Pro KreatuSitioWeb',
    mpAmount: 1999.99,
  },
  {
    id:       'proplus',
    name:     'Ecommerce',
    tag:      'Tu tienda en línea, lista para vender.',
    price:    '$3,499',
    cents:    '.99',
    pago:     'MXN · pago único',
    featured: false,
    cta:      'Lanzar mi tienda',
    features: [
      'Hasta 50 productos',
      'Pagos en MXN (MercadoPago)',
      'Envíos y cupones',
      'Panel para subir stock',
      'Integración WhatsApp',
      'Soporte prioritario 60 días',
    ],
    mpTitle:  'Plan Pro Plus KreatuSitioWeb',
    mpAmount: 3499.99,
  },
];
---
 
<section class="kt-precios" id="precios">
  <div class="kt-shell">
    <div class="kt-section__head">
      <div class="kt-eyebrow">
        <span class="kt-eyebrow__dot"></span>
        <span class="kt-mono">05 / Precios</span>
      </div>
      <h2 class="kt-section__title">
        Precios <em class="kt-italic">claros</em>.
        Sin renta mensual escondida.
      </h2>
      <p class="kt-section__lede">
        Pagas una vez. Si más adelante necesitas mantenimiento, te ofrecemos un plan opcional desde $349/mes.
      </p>
    </div>
 
    <div class="kt-planes__grid">
      {planes.map(p => (
        <article class:list={["kt-plan2", { "kt-plan2--hi": p.featured }]}>
          {p.featured && (
            <div class="kt-plan2__ribbon kt-mono">★ Más elegido</div>
          )}
 
          <div class="kt-plan2__head">
            <h3>{p.name}</h3>
            <p>{p.tag}</p>
          </div>
 
          <div class="kt-plan2__price">
            <span class="kt-plan2__big">{p.price}</span>
            <span class="kt-plan2__cents">{p.cents}</span>
          </div>
          <div class="kt-plan2__pago kt-mono">{p.pago}</div>
 
          <ul class="kt-plan2__feats">
            {p.features.map(f => (
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M5 12l5 5L20 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {f}
              </li>
            ))}
          </ul>
 
          <button
            class:list={["btn-plan", { "btn-plan--hi": p.featured }]}
            data-title={p.mpTitle}
            data-amount={p.mpAmount}
          >
            {p.cta}
          </button>
        </article>
      ))}
    </div>
 
    <div class="kt-precios__foot">
      <span class="kt-mono">// ¿Necesitas algo a medida? Hablemos. Cotizamos sin compromiso.</span>
    </div>
  </div>
</section>
 
<!-- MercadoPago integration — NO TOCAR -->
<script define:vars={{ API_URL }}>
  document.querySelectorAll('.btn-plan').forEach(btn => {
    btn.addEventListener('click', async () => {
      const title  = btn.dataset.title;
      const amount = parseFloat(btn.dataset.amount);
      const orig   = btn.textContent;
 
      btn.textContent = 'Procesando…';
      btn.disabled = true;
 
      try {
        const res  = await fetch(API_URL, {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ title, unit_price: amount, quantity: 1 }),
        });
        const data = await res.json();
        if (data.init_point) {
          window.location.href = data.init_point;
        } else {
          throw new Error('Sin init_point');
        }
      } catch (err) {
        console.error(err);
        btn.textContent = orig;
        btn.disabled = false;
        alert('Hubo un problema al procesar el pago. Por favor intenta de nuevo.');
      }
    });
  });
</script>
 
<style>
  /* ── Shell y utilidades compartidas ── */
  .kt-shell   { max-width: 1280px; margin: 0 auto; padding: 0 28px; }
  .kt-mono    { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; letter-spacing: .02em; }
  .kt-italic  { font-family: 'Instrument Serif', serif; font-style: italic; font-weight: 400; color: #0F6E56; }
  .kt-eyebrow { display: inline-flex; align-items: center; gap: 10px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #7a7d78; text-transform: uppercase; letter-spacing: .06em; }
  .kt-eyebrow__dot { width: 7px; height: 7px; border-radius: 999px; background: #1D9E75; box-shadow: 0 0 0 4px rgba(29,158,117,.18); }
  .kt-section__head { max-width: 760px; margin: 0 0 52px; }
  .kt-section__title { font-family: 'Instrument Serif', serif; font-weight: 400; font-size: clamp(32px,4vw,54px); line-height: 1.05; letter-spacing: -.02em; margin: 12px 0 16px; color: #181917; }
  .kt-section__lede  { font-size: 17px; color: #3a3d38; max-width: 580px; margin: 0; line-height: 1.6; }
 
  /* ── Sección ── */
  .kt-precios { padding: 120px 0; background: #faf9f5; border-top: 1px solid #e6e4df; }
 
  /* ── Grid ── */
  .kt-planes__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 1020px) { .kt-planes__grid { grid-template-columns: 1fr; max-width: 520px; } }
 
  /* ── Tarjeta ── */
  .kt-plan2 {
    background: #fff;
    border: 1px solid #e6e4df;
    border-radius: 20px;
    padding: 32px;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition: box-shadow .25s, transform .25s;
  }
  .kt-plan2:hover { box-shadow: 0 14px 40px rgba(20,30,28,.10); transform: translateY(-2px); }
 
  /* Featured */
  .kt-plan2--hi {
    background: #0F6E56;
    color: white;
    border-color: #0F6E56;
    transform: none;
    box-shadow: 0 30px 80px rgba(15,110,86,.28);
  }
  .kt-plan2--hi:hover { transform: translateY(-3px); }
 
  /* Ribbon */
  .kt-plan2__ribbon {
    position: absolute; top: -14px; left: 28px;
    background: #c9a84c; color: #3a2a00;
    padding: 6px 14px; border-radius: 999px;
    font-size: 12px; font-weight: 700; letter-spacing: .04em;
  }
 
  /* Head */
  .kt-plan2__head h3 { font-family: 'Instrument Serif', serif; font-weight: 400; font-size: 30px; margin: 0 0 6px; letter-spacing: -.01em; }
  .kt-plan2__head p  { font-size: 14px; color: #7a7d78; margin: 0; line-height: 1.4; }
  .kt-plan2--hi .kt-plan2__head p { color: rgba(255,255,255,.7); }
 
  /* Price */
  .kt-plan2__price { display: flex; align-items: baseline; }
  .kt-plan2__big   { font-family: 'Instrument Serif', serif; font-size: 58px; line-height: 1; letter-spacing: -.02em; font-weight: 400; }
  .kt-plan2__cents { font-family: 'Instrument Serif', serif; font-size: 22px; color: #7a7d78; margin-left: 2px; }
  .kt-plan2--hi .kt-plan2__cents { color: rgba(255,255,255,.55); }
  .kt-plan2__pago  { color: #7a7d78; }
  .kt-plan2--hi .kt-plan2__pago { color: rgba(255,255,255,.6); }
 
  /* Features */
  .kt-plan2__feats { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .kt-plan2__feats li { display: flex; align-items: flex-start; gap: 10px; font-size: 14.5px; color: #3a3d38; }
  .kt-plan2--hi .kt-plan2__feats li { color: rgba(255,255,255,.88); }
  .kt-plan2__feats svg { color: #1D9E75; margin-top: 3px; flex-shrink: 0; }
  .kt-plan2--hi .kt-plan2__feats svg { color: #c9a84c; }
 
  /* Button */
  .btn-plan {
    display: block; width: 100%; padding: 14px;
    border-radius: 999px; border: 1.5px solid #cdc9c2;
    background: transparent; color: #181917;
    font-family: 'Geist', sans-serif; font-size: 15px; font-weight: 600;
    cursor: pointer; transition: background .2s, border-color .2s, color .2s, transform .15s;
    text-align: center;
  }
  .btn-plan:hover { background: #f4f3ef; border-color: #0F6E56; color: #0F6E56; transform: translateY(-1px); }
  .btn-plan:disabled { opacity: .6; cursor: not-allowed; transform: none; }
 
  .btn-plan--hi {
    background: #1D9E75; color: #fff; border-color: #1D9E75;
  }
  .btn-plan--hi:hover { background: #178A63; border-color: #178A63; color: #fff; }
 
  /* Foot */
  .kt-precios__foot { text-align: center; margin-top: 32px; color: #7a7d78; }
</style>
 