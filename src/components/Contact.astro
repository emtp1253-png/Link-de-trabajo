---
const contactItems = [
  { icon: '📧', text: 'projectmannager@kreatusitioweb.com', href: 'mailto:projectmannager@kreatusitioweb.com' },
  { icon: '💬', text: '+52 229 873 5788 (WhatsApp)', href: 'https://wa.me/522298735788' },
  { icon: '⏰', text: 'Lun–Vie de 9:00 a 18:00 hrs', href: null },
  { icon: '🇲🇽', text: 'Toda la República Mexicana', href: null },
];
---

<section class="contact" id="contacto">
  <div class="section-inner">

    <div class="contact-grid">

      <!-- COLUMNA IZQUIERDA -->
      <div class="contact-info">
        <div class="section-label">Contacto</div>
        <h2>¿Listo para tener tu página web?</h2>
        <p>
          Cuéntanos sobre tu negocio y te respondemos en menos de 24 horas
          con una propuesta sin compromiso.
        </p>

        <ul class="contact-items">
          {contactItems.map(({ icon, text, href }) => (
            <li class="contact-item">
              <div class="contact-icon" aria-hidden="true">{icon}</div>
              {href
                ? <a href={href}>{text}</a>
                : <span>{text}</span>
              }
            </li>
          ))}
        </ul>
      </div>

      <!-- COLUMNA DERECHA — FORMULARIO -->
      <div class="contact-form-wrap">
        <form
          id="contact-form"
          action="https://formspree.io/f/maqvjbeg"
          method="POST"
        >
          <div class="form-row">
            <div class="form-group">
              <label for="nombre">Nombre *</label>
              <input
                id="nombre"
                type="text"
                name="nombre"
                placeholder="Tu nombre"
                required
              />
            </div>
            <div class="form-group">
              <label for="empresa">Empresa</label>
              <input
                id="empresa"
                type="text"
                name="empresa"
                placeholder="Nombre del negocio"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="email">Correo electrónico *</label>
            <input
              id="email"
              type="email"
              name="email"
              placeholder="correo@tunegocio.com"
              required
            />
          </div>

          <div class="form-group">
            <label for="telefono">Teléfono / WhatsApp</label>
            <input
              id="telefono"
              type="tel"
              name="telefono"
              placeholder="+52 55 0000-0000"
            />
          </div>

          <div class="form-group">
            <label for="plan">Plan de interés</label>
            <select id="plan" name="plan">
              <option value="">Selecciona un plan...</option>
              <option value="esencial">Plan Esencial — $999.99 + IVA</option>
              <option value="profesional">Plan Profesional — $1,999.99 + IVA</option>
              <option value="pro-plus">Plan Pro Plus — $3,499.99 + IVA ⭐ (Más vendido)</option>
              <option value="ecommerce">Plan Ecommerce — $7,499.99 + IVA</option>
              <option value="personalizado">Cotización personalizada</option>
            </select>
          </div>

          <div class="form-group">
            <label for="mensaje">Cuéntanos sobre tu negocio</label>
            <textarea
              id="mensaje"
              name="mensaje"
              placeholder="¿A qué se dedica tu empresa? ¿Qué necesitas en tu página?"
            ></textarea>
          </div>

          <input type="text" name="_gotcha" style="display:none" />

          <button type="submit" class="btn-submit">Enviar mensaje →</button>
        </form>

        <div id="success-msg" class="success-msg" aria-live="polite">
          ✅ ¡Mensaje enviado! Te contactamos en menos de 24 horas.
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('success-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Enviando…';

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.style.display = 'none';
        if (success) success.classList.add('visible');
      } else {
        btn.disabled = false;
        btn.textContent = 'Enviar mensaje →';
        alert('Hubo un error al enviar. Por favor intenta de nuevo.');
      }
    } catch {
      btn.disabled = false;
      btn.textContent = 'Enviar mensaje →';
      alert('Sin conexión. Por favor intenta de nuevo.');
    }
  });
</script>

<style>
  .contact {
    padding: 2rem 5% 5rem;
  }

  .section-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .section-label {
    font-family: 'Geist', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    color: #1D9E75;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 0.75rem;
  }

  .contact-info h2 {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 400;
    color: #181917;
    letter-spacing: -0.5px;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .contact-info > p {
    font-size: 1rem;
    color: #4B5563;
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  .contact-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.9rem;
    color: #374151;
  }

  .contact-item a {
    color: #374151;
    text-decoration: none;
    transition: color 0.2s;
  }

  .contact-item a:hover { color: #1D9E75; }

  .contact-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #E6F7F2;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .contact-form-wrap {
    background: #F9FAFB;
    border-radius: 20px;
    border: 1px solid #E5E7EB;
    padding: 2.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .form-group label {
    font-size: 0.82rem;
    font-weight: 600;
    color: #374151;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: 1.5px solid #E5E7EB;
    font-family: 'Geist', sans-serif;
    font-size: 0.9rem;
    color: #1F2937;
    background: #fff;
    outline: none;
    transition: border-color 0.2s;
    resize: none;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus { border-color: #1D9E75; box-shadow: 0 0 0 3px rgba(29,158,117,.12); }

  .form-group textarea { min-height: 100px; }

  .btn-submit {
    width: 100%;
    padding: 0.9rem;
    background: #1D9E75;
    color: #fff;
    border: none;
    border-radius: 999px;
    font-family: 'Geist', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
  }

  .btn-submit:hover:not(:disabled) { background: #0F6E56; transform: translateY(-1px); }
  .btn-submit:disabled { opacity: 0.65; cursor: not-allowed; }

  .success-msg {
    display: none;
    text-align: center;
    padding: 2rem 1rem;
    font-family: 'Geist', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: #0F6E56;
    line-height: 1.6;
  }

  .success-msg.visible { display: block; }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  @media (max-width: 560px) {
    .contact { padding: 3.5rem 5%; }
    .contact-form-wrap { padding: 1.5rem; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>