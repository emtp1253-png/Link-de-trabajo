---
const contactItems = [
  { icon: '📧', text: 'hola@kreatusitioweb.com', href: 'mailto:hola@kreatusitioweb.com' },
  { icon: '⏰', text: 'Lun–Vie de 9:00 a 18:00 hrs', href: null },
  { icon: '🇲🇽', text: 'Toda la República Mexicana', href: null },
];
---

<section class="contact" id="contacto">
  <div class="section-inner">

    <div class="contact-grid">

      <!-- COLUMNA IZQUIERDA -->
      <div class="contact-info">
        <div class="section-label">Contacto</div>
        <h2>¿Listo para tener tu página web?</h2>
        <p>
          Cuéntanos sobre tu negocio y te respondemos en menos de 24 horas
          con una propuesta sin compromiso.
        </p>

        <ul class="contact-items">
          {contactItems.map(({ icon, text, href }) => (
            <li class="contact-item">
              <div class="contact-icon" aria-hidden="true">{icon}</div>
              {href
                ? <a href={href}>{text}</a>
                : <span>{text}</span>
              }
            </li>
          ))}
        </ul>
      </div>

      <!-- COLUMNA DERECHA — FORMULARIO -->
      <!-- action: reemplaza XXXXXXXX con tu ID real de Formspree -->
      <div class="contact-form-wrap">
        <form
          id="contact-form"
          action="https://formspree.io/f/XXXXXXXX"
          method="POST"
        >
          <div class="form-row">
            <div class="form-group">
              <label for="nombre">Nombre *</label>
              <input
                id="nombre"
                type="text"
                name="nombre"
                placeholder="Tu nombre"
                required
              />
            </div>
            <div class="form-group">
              <label for="empresa">Empresa</label>
              <input
                id="empresa"
                type="text"
                name="empresa"
                placeholder="Nombre del negocio"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="email">Correo electrónico *</label>
            <input
              id="email"
              type="email"
              name="email"
              placeholder="correo@tunegocio.com"
              required
            />
          </div>

          <div class="form-group">
            <label for="telefono">Teléfono / WhatsApp</label>
            <input
              id="telefono"
              type="tel"
              name="telefono"
              placeholder="+52 55 0000-0000"
            />
          </div>

          <div class="form-group">
            <label for="plan">Plan de interés</label>
            <select id="plan" name="plan">
              <option value="">Selecciona un plan...</option>
              <option value="starter">Plan Starter — $999.99</option>
              <option value="pro">Plan Pro — $1,999.99 ⭐ (Recomendado)</option>
              <option value="pro-plus">Plan Pro Plus — $3,499.99</option>
              <option value="personalizado">Cotización personalizada</option>
            </select>
          </div>

          <div class="form-group">
            <label for="mensaje">Cuéntanos sobre tu negocio</label>
            <textarea
              id="mensaje"
              name="mensaje"
              placeholder="¿A qué se dedica tu empresa? ¿Qué necesitas en tu página?"
            ></textarea>
          </div>

          <!-- honeypot anti-spam requerido por Formspree -->
          <input type="text" name="_gotcha" style="display:none" />

          <button type="submit" class="btn-submit">Enviar mensaje →</button>
        </form>

        <div id="success-msg" class="success-msg" aria-live="polite">
          ✅ ¡Mensaje enviado! Te contactamos en menos de 24 horas.
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('success-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Enviando…';

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.style.display = 'none';
        if (success) success.classList.add('visible');
      } else {
        btn.disabled = false;
        btn.textContent = 'Enviar mensaje →';
        alert('Hubo un error al enviar. Por favor intenta de nuevo.');
      }
    } catch {
      btn.disabled = false;
      btn.textContent = 'Enviar mensaje →';
      alert('Sin conexión. Por favor intenta de nuevo.');
    }
  });
</script>

<style>
  .contact {
    padding: 2rem 5% 5rem; /* Reducido el padding superior para eliminar el espacio en blanco */
  }

  .section-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* ── GRID ── */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  /* ── LEFT COLUMN ── */
  .section-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--teal-500);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 0.75rem;
  }

  .contact-info h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    color: var(--gray-900);
    letter-spacing: -0.5px;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .contact-info > p {
    font-size: 1rem;
    color: var(--gray-600);
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  .contact-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.9rem;
    color: var(--gray-700, #374151);
  }

  .contact-item a {
    color: var(--gray-700, #374151);
    text-decoration: none;
    transition: color 0.2s;
  }

  .contact-item a:hover {
    color: var(--teal-500);
  }

  .contact-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--teal-50);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }

  /* ── RIGHT COLUMN ── */
  .contact-form-wrap {
    background: var(--gray-50, #F9FAFB);
    border-radius: 20px;
    border: 1px solid var(--gray-200);
    padding: 2.25rem;
  }

  /* ── FORM FIELDS ── */
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .form-group label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--gray-700, #374151);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: 1.5px solid var(--gray-200);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    color: var(--gray-800);
    background: #fff;
    outline: none;
    transition: border-color 0.2s;
    resize: none;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--teal-400);
  }

  .form-group textarea {
    min-height: 100px;
  }

  /* ── SUBMIT ── */
  .btn-submit {
    width: 100%;
    padding: 0.9rem;
    background: var(--teal-400);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-submit:hover:not(:disabled) {
    background: var(--teal-600);
  }

  .btn-submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  /* ── SUCCESS MESSAGE ── */
  .success-msg {
    display: none;
    text-align: center;
    padding: 2rem 1rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--teal-600);
    line-height: 1.6;
  }

  .success-msg.visible {
    display: block;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 560px) {
    .contact { padding: 3.5rem 5%; }
    .contact-form-wrap { padding: 1.5rem; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>
