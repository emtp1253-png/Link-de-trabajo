---
interface Props {
  title?: string;
  description?: string;
}

const {
  title       = 'Diseño de Página Web Profesional y Económica en México | KreatuSitioWeb',
  description = 'Crea tu sitio web profesional desde $999.99 MXN. Diseño de página web económico, responsivo y con SEO incluido. Entrega en 7 días.',
} = Astro.props;

const siteUrl = 'https://kreatusitioweb.com';

const navLinks = [
  { href: '#beneficios',   label: 'Beneficios' },
  { href: '#proceso',      label: 'Cómo funciona' },
  { href: '#demo',         label: 'Demo' },
  { href: '/kreatubot',    label: 'KreatuBot' },
  { href: '#precios',      label: 'Precios' },
  { href: '#contacto',     label: 'Contacto' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'KreatuSitioWeb',
  description: 'Diseño de páginas web profesionales y económicas en México.',
  url: siteUrl,
  email: 'projectmannager@kreatusitioweb.com',
  areaServed: 'MX',
  priceRange: '$',
  serviceType: 'Diseño y desarrollo de páginas web',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Planes de diseño web',
    itemListElement: [
      { '@type': 'Offer', name: 'Plan Starter',  price: '999.99',  priceCurrency: 'MXN' },
      { '@type': 'Offer', name: 'Plan Pro',       price: '1999.99', priceCurrency: 'MXN' },
      { '@type': 'Offer', name: 'Plan Pro Plus',  price: '3499.99', priceCurrency: 'MXN' },
    ]
  }
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="diseño de página web, diseño de pagina web profesional, diseño de pagina web economico, crear sitio web, pagina web, sitio web, diseño web México" />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="MX" />
    <link rel="canonical" href={siteUrl} />
    <meta name="google-site-verification" content="Zx7xJA_eWDfVg2U-RfloA7B_87rW-SXGD0SpiI99tO4" />
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={siteUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale"      content="es_MX" />
    <meta name="twitter:card"       content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json">{
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "KreatuSitioWeb",
      "url": "https://kreatusitioweb.com",
      "logo": "https://kreatusitioweb.com/favicon-180.png"
    }</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300..700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>

  <body>
    <nav>
      <div class="nav-inner">
        <a href="/" class="kt-logo" aria-label="KreatuSitioWeb inicio">
          <span class="kt-logo__mark" aria-hidden="true">
            <span class="kt-logo__dot"></span>
            <span class="kt-logo__bar"></span>
          </span>
          <span class="kt-logo__text">
            <strong>Kreatu</strong><span>SitioWeb</span>
          </span>
        </a>
        <ul class="nav-links">
          {navLinks.map(({ href, label }) => (
            <li><a href={href} class:list={[{ 'nav-demo': href === '#demo' }]}>{label}</a></li>
          ))}
        </ul>
        <a href="#contacto" class="btn-nav">Empezar ahora</a>
        <button class="hamburger" id="hamburger-btn" aria-label="Abrir menú">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>

    <main><slot /></main>

    <footer>
      <div class="footer-inner">
        <a href="/" class="kt-logo kt-logo--footer">
          <span class="kt-logo__mark" aria-hidden="true">
            <span class="kt-logo__dot" style="background:#1D9E75"></span>
            <span class="kt-logo__bar" style="background:#1D9E75"></span>
          </span>
          <span class="kt-logo__text">
            <strong style="color:#1D9E75">Kreatu</strong><span style="color:#fff">SitioWeb</span>
          </span>
        </a>
        <span class="footer-copy">© {new Date().getFullYear()} KreatuSitioWeb · Diseño de páginas web en México</span>
        <ul class="footer-links">
          <li><a href="#">Aviso de privacidad</a></li>
          <li><a href="#">Términos</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </div>
    </footer>

    <!-- TODO: reemplaza 52XXXXXXXXXX con tu número real de WhatsApp -->
    <a href="https://wa.me/522298735788" class="kt-fab" target="_blank" rel="noopener noreferrer" aria-label="Hablar por WhatsApp">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20.5 3.5A11.7 11.7 0 0012 0C5.4 0 0 5.4 0 12c0 2.1.6 4.2 1.6 6L0 24l6.2-1.6A12 12 0 0012 24c6.6 0 12-5.4 12-12 0-3.2-1.2-6.2-3.5-8.5zM12 22a9.9 9.9 0 01-5.1-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.9 9.9 0 012 12C2 6.5 6.5 2 12 2s10 4.5 10 10-4.5 10-10 10zm5.5-7.4c-.3-.1-1.8-.9-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.4.2-.7.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.2-.2.2-.3.3-.5.1-.2.1-.4 0-.5-.1-.2-.7-1.7-1-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2.1 3.2 5.2 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2.1-1.4.2-.7.2-1.3.1-1.5z"/>
      </svg>
      <span>Hablar ahora</span>
    </a>
  </body>
</html>

<script>
  // Hamburger menu — addEventListener, no onclick en HTML
  const hamburger = document.getElementById('hamburger-btn');
  const navLinks  = document.querySelector('.nav-links') as HTMLElement | null;

  hamburger?.addEventListener('click', () => {
    if (!navLinks) return;
    const isOpen = navLinks.dataset.open === 'true';
    if (isOpen) {
      navLinks.removeAttribute('style');
      navLinks.dataset.open = 'false';
    } else {
      navLinks.style.cssText = 'display:flex;flex-direction:column;position:absolute;top:64px;left:0;right:0;background:#faf9f5;padding:1rem 5%;border-bottom:1px solid #e6e4df;z-index:99;gap:1.25rem;';
      navLinks.dataset.open = 'true';
    }
  });

  // Cierra el menú al tocar un link
  navLinks?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      navLinks.removeAttribute('style');
      navLinks.dataset.open = 'false';
    });
  });
</script>

<style is:global>
  :root {
    --teal-50:  #E6F7F2;
    --teal-100: #BFEAD9;
    --teal-400: #1D9E75;
    --teal-500: #178A63;
    --teal-600: #0F6E56;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Geist', system-ui, sans-serif; color: #181917; background: #faf9f5; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  img, svg { display: block; max-width: 100%; }
  button { font: inherit; color: inherit; cursor: pointer; }

  nav { position: sticky; top: 0; z-index: 100; background: rgba(250,249,245,0.92); backdrop-filter: saturate(140%) blur(12px); border-bottom: 1px solid #e6e4df; padding: 0 5%; }
  .nav-inner { max-width: 1280px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 20px; }

  /* LOGO */
  .kt-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: #181917; flex-shrink: 0; }
  .kt-logo__mark { position: relative; width: 26px; height: 26px; display: inline-block; flex-shrink: 0; }
  .kt-logo__dot { position: absolute; left: 0; top: 4px; width: 14px; height: 14px; border-radius: 999px; background: #1D9E75; }
  .kt-logo__bar { position: absolute; right: 0; top: 0; width: 6px; height: 22px; background: #0F6E56; border-radius: 3px; transform: skewX(-12deg); }
  .kt-logo__text { font-family: 'Geist', sans-serif; font-size: 1.1rem; letter-spacing: -0.01em; }
  .kt-logo__text strong { color: #0F6E56; font-weight: 700; }
  .kt-logo__text span   { color: #181917; font-weight: 500; }

  .nav-links { display: flex; gap: 1.75rem; list-style: none; }
  .nav-links a { font-size: 0.9rem; font-weight: 500; color: #3a3d38; text-decoration: none; transition: color 0.2s; }
  .nav-links a:hover { color: #1D9E75; }
  .nav-links a.nav-demo { color: #0F6E56; font-weight: 600; background: #E6F7F2; padding: 4px 12px; border-radius: 999px; font-size: 0.85rem; }
  .nav-links a.nav-demo:hover { background: #BFEAD9; }

  .btn-nav { background: #1D9E75; color: #fff; padding: 0.5rem 1.25rem; border-radius: 999px; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: background 0.2s; border: none; white-space: nowrap; }
  .btn-nav:hover { background: #0F6E56; }

  .hamburger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
  .hamburger span { width: 24px; height: 2px; background: #181917; border-radius: 2px; }

  footer { background: #181917; padding: 2.5rem 5%; }
  .footer-inner { max-width: 1280px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
  .footer-copy { font-size: 0.8rem; color: #7a7d78; }
  .footer-links { display: flex; gap: 1.5rem; list-style: none; }
  .footer-links a { font-size: 0.85rem; color: #7a7d78; text-decoration: none; transition: color 0.2s; }
  .footer-links a:hover { color: #1D9E75; }

  .kt-fab { position: fixed; bottom: 24px; right: 24px; z-index: 200; display: inline-flex; align-items: center; gap: 10px; background: #25D366; color: white; padding: 14px 20px; border-radius: 999px; text-decoration: none; font-family: 'Geist', sans-serif; font-size: 14px; font-weight: 600; box-shadow: 0 12px 30px rgba(37,211,102,0.4); transition: transform .2s, box-shadow .2s; }
  .kt-fab:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 16px 40px rgba(37,211,102,0.5); }
  @media (max-width: 600px) { .kt-fab span { display: none; } .kt-fab { padding: 14px; } }

  @media (max-width: 768px) { .nav-links, .btn-nav { display: none; } .hamburger { display: flex; } .footer-inner { flex-direction: column; text-align: center; } .footer-links { justify-content: center; } }
  main { min-height: 60vh; }
</style>