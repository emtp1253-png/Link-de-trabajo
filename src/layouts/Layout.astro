---
interface Props {
  title?: string;
  description?: string;
}
 
const {
  title       = 'KreatuSitioWeb — Tu presencia digital profesional',
  description = 'Creamos tu sitio web profesional desde $999.99 MXN. Diseño responsivo, SEO incluido y entrega en 7 días. KreatuSitioWeb.',
} = Astro.props;
 
const siteUrl = 'https://kreatusitioweb.com';
 
const navLinks = [
  { href: '#beneficios', label: 'Beneficios' },
  { href: '#proceso',    label: 'Cómo funciona' },
  { href: '#precios',    label: 'Precios' },
  { href: '#contacto',   label: 'Contacto' },
];
 
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'KreatuSitioWeb',
  description,
  url: siteUrl,
  email: 'projectmannager@kreatusitioweb.com',
  areaServed: 'MX',
  priceRange: '$$',
  serviceType: 'Diseño y desarrollo de páginas web',
};
---
 
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 
    <!-- SEO BÁSICO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords"    content="diseño web, páginas web económicas, sitio web profesional México" />
    <link rel="canonical"    href={siteUrl} />
 
    <!-- GOOGLE SEARCH CONSOLE -->
    <meta name="google-site-verification" content="Zx7xJA_eWDfVg2U-RfloA7B_87rW-SXGD0SpiI99tO4" />
 
    <!-- OPEN GRAPH -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={siteUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
 
    <!-- TWITTER CARD -->
    <meta name="twitter:card"        content="summary" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
 
    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
 
    <!-- FUENTES -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
 
  <body>
 
    <!-- NAV -->
    <nav>
      <div class="nav-inner">
        <a href="/" class="logo">Kreatu<span>SitioWeb</span></a>
 
        <ul class="nav-links">
          {navLinks.map(({ href, label }) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
 
        <a href="#contacto" class="btn-nav">Empezar ahora</a>
 
        <button class="hamburger" aria-label="Abrir menú" onclick="toggleMenu()">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </nav>
 
    <!-- CONTENIDO DE PÁGINA -->
    <main>
      <slot />
    </main>
 
    <!-- FOOTER -->
    <footer>
      <div class="footer-inner">
        <a href="/" class="logo">Kreatu<span>SitioWeb</span></a>
        <span class="footer-copy">© {new Date().getFullYear()} KreatuSitioWeb · Todos los derechos reservados</span>
        <ul class="footer-links">
          <li><a href="#">Aviso de privacidad</a></li>
          <li><a href="#">Términos</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </div>
    </footer>
 
    <!-- WHATSAPP FLOTANTE -->
    <!-- TODO: reemplazar 52XXXXXXXXXX por tu número real cuando lo tengas -->
    <a
      href="https://wa.me/52XXXXXXXXXX"
      class="whatsapp-fab"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contáctanos por WhatsApp"
    >
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path
          d="M16 2C8.268 2 2 8.268 2 16c0 2.417.632 4.765 1.832 6.833L2 30l7.395-1.805A13.94 13.94 0 0 0 16 30c7.732 0 14-6.268 14-14S23.732 2 16 2Z"
          fill="#25D366"
        />
        <path
          d="M22.5 19.375c-.308-.154-1.82-.897-2.102-.999-.282-.103-.487-.154-.692.154-.205.308-.795.999-.974 1.204-.18.205-.359.23-.667.077-.308-.154-1.3-.479-2.476-1.527-.915-.816-1.533-1.823-1.712-2.131-.18-.308-.019-.474.135-.627.138-.138.308-.359.462-.538.154-.18.205-.308.308-.513.103-.205.051-.385-.026-.538-.077-.154-.692-1.667-.948-2.283-.25-.6-.503-.518-.692-.528l-.59-.01c-.205 0-.538.077-.82.385-.282.308-1.077 1.052-1.077 2.565 0 1.513 1.103 2.975 1.257 3.18.154.205 2.17 3.312 5.258 4.643.735.317 1.308.507 1.756.649.738.235 1.41.202 1.941.122.592-.088 1.82-.744 2.077-1.462.257-.718.257-1.333.18-1.462-.077-.128-.282-.205-.59-.359Z"
          fill="#fff"
        />
      </svg>
      <span class="whatsapp-tooltip">¡Escríbenos!</span>
    </a>
 
  </body>
</html>
 
<script>
  function toggleMenu() {
    const links = document.querySelector('.nav-links') as HTMLElement | null;
    const isOpen = links?.dataset.open === 'true';
    if (!links) return;
    if (isOpen) {
      links.removeAttribute('style');
      links.dataset.open = 'false';
    } else {
      links.style.cssText = 'display:flex;flex-direction:column;position:absolute;top:64px;left:0;right:0;background:#fff;padding:1rem 5%;border-bottom:1px solid #E5E7EB;z-index:99;gap:1.25rem;';
      links.dataset.open = 'true';
    }
  }
 
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };
 
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, observerOptions);
 
  document.addEventListener('DOMContentLoaded', () => {
    const revealElements = document.querySelectorAll('.reveal');
    revealElements.forEach(el => observer.observe(el));
  });
</script>
 
<style is:global>
  :root {
    --teal-50:  #E6F7F2;
    --teal-100: #BFEAD9;
    --teal-400: #1D9E75;
    --teal-500: #178A63;
    --teal-600: #0F6E56;
    --gray-50:  #F9FAFB;
    --gray-100: #F3F4F6;
    --gray-200: #E5E7EB;
    --gray-400: #9CA3AF;
    --gray-500: #6B7280;
    --gray-600: #4B5563;
    --gray-800: #1F2937;
    --gray-900: #111827;
  }
 
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
 
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
 
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
 
  html { scroll-behavior: smooth; }
 
  body {
    font-family: 'DM Sans', sans-serif;
    color: var(--gray-800);
    background: #fff;
    line-height: 1.6;
  }
 
  h1, h2, h3, h4, .logo, .btn-nav {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
 
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--gray-200);
    padding: 0 5%;
  }
 
  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
 
  .logo {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--teal-600);
    text-decoration: none;
    letter-spacing: -0.5px;
  }
 
  .logo span { color: var(--gray-900); }
 
  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
  }
 
  .nav-links a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--gray-600);
    text-decoration: none;
    transition: color 0.2s;
  }
 
  .nav-links a:hover { color: var(--teal-500); }
 
  .btn-nav {
    background: var(--teal-400);
    color: #fff;
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
    white-space: nowrap;
  }
 
  .btn-nav:hover { background: var(--teal-600); }
 
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
 
  .hamburger span {
    width: 24px;
    height: 2px;
    background: var(--gray-800);
    border-radius: 2px;
    transition: all 0.3s;
  }
 
  main { min-height: 60vh; }
 
  footer {
    background: var(--gray-900);
    padding: 2.5rem 5%;
  }
 
  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
 
  footer .logo { color: var(--teal-400); }
  footer .logo span { color: #fff; }
 
  .footer-copy {
    font-size: 0.85rem;
    color: var(--gray-400);
  }
 
  .footer-links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
  }
 
  .footer-links a {
    font-size: 0.85rem;
    color: var(--gray-400);
    text-decoration: none;
    transition: color 0.2s;
  }
 
  .footer-links a:hover { color: var(--teal-400); }
 
  @keyframes waBounceIn {
    0%   { opacity: 0; transform: scale(0.4) translateY(20px); }
    60%  { opacity: 1; transform: scale(1.12) translateY(-4px); }
    80%  { transform: scale(0.95) translateY(2px); }
    100% { transform: scale(1) translateY(0); }
  }
 
  .whatsapp-fab {
    position: fixed;
    bottom: 1.75rem;
    right: 1.75rem;
    z-index: 200;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25D366;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.45);
    animation: waBounceIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 1.2s both;
    transition: transform 0.2s, box-shadow 0.2s;
  }
 
  .whatsapp-fab:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 28px rgba(37, 211, 102, 0.55);
  }
 
  .whatsapp-fab svg { width: 30px; height: 30px; }
 
  .whatsapp-tooltip {
    position: absolute;
    right: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%);
    background: var(--gray-900);
    color: #fff;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
  }
 
  .whatsapp-tooltip::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    border: 5px solid transparent;
    border-left-color: var(--gray-900);
  }
 
  .whatsapp-fab:hover .whatsapp-tooltip { opacity: 1; }
 
  @media (max-width: 768px) {
    .nav-links,
    .btn-nav { display: none; }
    .hamburger { display: flex; }
    .footer-inner { flex-direction: column; text-align: center; }
    .footer-links { justify-content: center; }
    .whatsapp-fab { bottom: 1.25rem; right: 1.25rem; }
  }
</style>