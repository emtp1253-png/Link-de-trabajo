/* ── APP ── */
function App() {
  const [activeId, setActiveId] = useState("doctor");
  useEffect(()=>{
    const onClick = e => {
      const a = e.target.closest('a[href^="#"]');
      if (!a) return;
      const id = a.getAttribute("href").slice(1);
      if (!id) return;
      const el = document.getElementById(id);
      if (el) { e.preventDefault(); window.scrollTo({top:el.getBoundingClientRect().top+window.scrollY-60,behavior:"smooth"}); }
    };
    document.addEventListener("click",onClick);
    return ()=>document.removeEventListener("click",onClick);
  },[]);
  return (
    <>
      <Nav/>
      <Hero/>
      <IndustriesStrip active={activeId} onPick={id=>{
        setActiveId(id);
        const el=document.getElementById("demo");
        if(el) window.scrollTo({top:el.getBoundingClientRect().top+window.scrollY-60,behavior:"smooth"});
      }}/>
      <Demo activeId={activeId} setActiveId={setActiveId}/>
      <Agents/>
      <How/>
      <ROI/>
      <Testimonials/>
      <Pricing/>
      <FAQ/>
      <CTA/>
      <Footer/>
    </>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App/>);
  </script>
