---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
---

<Layout
  title="KreatuBot — Automatización y Agentes de IA para tu Negocio | KreatuSitioWeb"
  description="Automatiza tu atención al cliente, ventas y seguimiento de leads con KreatuBot. Agentes de IA para WhatsApp disponibles 24/7 para hacer crecer tu negocio."
>

<!-- ═══════════════════ HERO ═══════════════════ -->
<section class="kb-hero">
  <div class="kb-hero__bg" aria-hidden="true">
    <div class="kb-hero__grid"></div>
    <div class="kb-hero__glow"></div>
    <div class="kb-hero__glow kb-hero__glow--2"></div>
  </div>

  <div class="kt-shell kb-hero__inner">
    <div class="kb-hero__copy">
      <div class="kt-eyebrow">
        <span class="kt-eyebrow__dot"></span>
        <span>KreatuBot · Automatización con IA</span>
        <span class="kt-eyebrow__sep">/</span>
        <span class="kt-mono">servicio independiente</span>
      </div>

      <h1 class="kb-hero__title">
        Tu negocio
        <em class="kb-italic">trabajando</em><br/>
        mientras tú<br/>
        <span class="kb-underline">descansas.</span>
      </h1>

      <p class="kb-hero__lede">
        KreatuBot es nuestro sistema de agentes de inteligencia artificial que atiende a tus clientes, genera ventas y da seguimiento a tus leads — <em>las 24 horas, los 7 días de la semana</em>, sin que tú tengas que estar al pendiente.
      </p>

      <div class="kb-hero__ctas">
        <a href="#contacto" class="kt-btn kb-btn--primary kb-btn--lg">Quiero KreatuBot →</a>
        <a href="#como-funciona" class="kt-btn kb-btn--ghost kb-btn--lg">¿Cómo funciona?</a>
      </div>

      <ul class="kb-hero__proof">
        <li><strong>24/7</strong> disponible</li>
        <li><strong>0</strong> leads perdidos</li>
        <li><strong>IA</strong> entrenada en tu negocio</li>
        <li><strong>WhatsApp</strong> integrado</li>
      </ul>
    </div>

    <!-- Chat simulado -->
    <div class="kb-chat-preview">
      <div class="kb-chat__header">
        <div class="kb-chat__avatar">
          <span>KB</span>
          <span class="kb-chat__status"></span>
        </div>
        <div class="kb-chat__info">
          <strong>KreatuBot</strong>
          <span>Agente de tu negocio · En línea</span>
        </div>
        <div class="kb-chat__badge kt-mono">IA</div>
      </div>
      <div class="kb-chat__body" id="chat-body">
        <div class="kb-chat__msg kb-chat__msg--bot">
          <p>¡Hola! 👋 Soy el asistente de <strong>Tu Negocio</strong>. ¿En qué te puedo ayudar hoy?</p>
          <span class="kb-chat__time">Ahora mismo</span>
        </div>
      </div>
      <div class="kb-chat__options" id="chat-opts">
        <button class="kb-chat__opt" onclick="chatReply('precios')">💰 Ver precios</button>
        <button class="kb-chat__opt" onclick="chatReply('cita')">📅 Agendar cita</button>
        <button class="kb-chat__opt" onclick="chatReply('info')">ℹ️ Más información</button>
      </div>
      <div class="kb-chat__foot kt-mono">
        <span class="kb-pulse"></span> Powered by KreatuBot
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════ PROBLEMA / SOLUCIÓN ═══════════════════ -->
<section class="kb-problem">
  <div class="kt-shell">
    <div class="kb-problem__grid">
      <div class="kb-problem__col kb-problem__col--bad">
        <div class="kb-problem__head kt-mono">// sin KreatuBot</div>
        {[
          "Clientes escriben a las 11pm y no reciben respuesta",
          "Leads que no dan seguimiento se van con la competencia",
          "Preguntas repetidas que consumen tiempo de tu equipo",
          "Citas agendadas sin confirmar que se convierten en no-shows",
          "Ventas perdidas por no contestar a tiempo",
        ].map(p => (
          <div class="kb-problem__item kb-problem__item--bad">
            <span class="kb-problem__icon">✕</span>
            <span>{p}</span>
          </div>
        ))}
      </div>

      <div class="kb-problem__divider">
        <div class="kb-problem__vs">VS</div>
      </div>

      <div class="kb-problem__col kb-problem__col--good">
        <div class="kb-problem__head kt-mono">// con KreatuBot</div>
        {[
          "Respuesta inmediata a cualquier hora, cualquier día",
          "Seguimiento automático hasta que el lead convierte",
          "El bot responde las FAQs, tú te enfocas en lo importante",
          "Confirmaciones y recordatorios automáticos de citas",
          "Nunca más un cliente sin atender por falta de tiempo",
        ].map(p => (
          <div class="kb-problem__item kb-problem__item--good">
            <span class="kb-problem__icon">✓</span>
            <span>{p}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════ SERVICIOS ═══════════════════ -->
<section class="kb-servicios" id="servicios">
  <div class="kt-shell">
    <div class="kt-section__head">
      <div class="kt-eyebrow"><span class="kt-eyebrow__dot"></span><span class="kt-mono">01 / Qué hace KreatuBot</span></div>
      <h2 class="kb-section__title">Tres agentes que trabajan <em class="kb-italic">por ti</em> sin parar.</h2>
      <p class="kt-section__lede">Cada bot se entrena con la información de tu negocio: productos, precios, horarios, servicios y el tono con el que quieres comunicarte.</p>
    </div>

    <div class="kb-servicios__grid">

      <!-- Bot 1: Atención al cliente -->
      <article class="kb-card">
        <div class="kb-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2v10z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="kb-card__num kt-mono">01</div>
        <h3>Agente de atención al cliente</h3>
        <p>Responde preguntas frecuentes, da información sobre horarios, precios y servicios, y resuelve dudas al instante — en el tono de voz de tu marca.</p>
        <ul class="kb-card__feats">
          <li>Integrado a WhatsApp Business</li>
          <li>Responde en segundos, 24/7</li>
          <li>Maneja múltiples conversaciones a la vez</li>
          <li>Escala a humano cuando lo necesita</li>
        </ul>
        <div class="kb-card__tag kt-mono">// customer service</div>
      </article>

      <!-- Bot 2: Ventas -->
      <article class="kb-card kb-card--hi">
        <div class="kb-card__ribbon kt-mono">★ Más solicitado</div>
        <div class="kb-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="kb-card__num kt-mono">02</div>
        <h3>Agente de ventas automatizado</h3>
        <p>Califica leads, presenta tu oferta, resuelve objeciones y guía al cliente hasta cerrar la venta o agendar una llamada contigo — sin intervención humana.</p>
        <ul class="kb-card__feats">
          <li>Calificación automática de leads</li>
          <li>Presenta productos y precios dinámicamente</li>
          <li>Maneja objeciones frecuentes</li>
          <li>Agenda citas directo en tu calendario</li>
        </ul>
        <div class="kb-card__tag kt-mono">// sales agent</div>
      </article>

      <!-- Bot 3: Follow-up -->
      <article class="kb-card">
        <div class="kb-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M22 12h-4l-3 9L9 3l-3 9H2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="kb-card__num kt-mono">03</div>
        <h3>Seguimiento automático de leads</h3>
        <p>Nunca más un prospecto olvidado. KreatuBot da seguimiento automático a cada lead según en qué parte del proceso esté — hasta que convierte o se descarta.</p>
        <ul class="kb-card__feats">
          <li>Secuencias de mensajes automatizadas</li>
          <li>Recordatorios de citas y pagos</li>
          <li>Reactivación de clientes inactivos</li>
          <li>Reportes de conversión automáticos</li>
        </ul>
        <div class="kb-card__tag kt-mono">// lead nurturing</div>
      </article>

    </div>
  </div>
</section>


<!-- ═══════════════════ CÓMO FUNCIONA ═══════════════════ -->
<section class="kb-como" id="como-funciona">
  <div class="kt-shell">
    <div class="kt-section__head">
      <div class="kt-eyebrow"><span class="kt-eyebrow__dot"></span><span class="kt-mono">02 / Proceso</span></div>
      <h2 class="kb-section__title">Listo en <em class="kb-italic">menos de una semana</em>.</h2>
    </div>

    <div class="kb-pasos">
      <div class="kb-pasos__line"></div>
      {[
        { n:"01", icon:"🎙️", t:"Nos cuentas tu negocio",   b:"Una sesión de 45 minutos donde recopilamos todo: tus servicios, precios, objeciones frecuentes, el tono de tu marca y cómo quieres que hable tu bot." },
        { n:"02", icon:"🧠", t:"Entrenamos a tu agente",   b:"Configuramos y entrenamos el bot con toda la información de tu negocio. Le enseñamos a hablar como tú, a manejar objeciones y a saber cuándo escalar." },
        { n:"03", icon:"🔗", t:"Integramos con WhatsApp",  b:"Conectamos KreatuBot a tu WhatsApp Business o número de empresa. Lo probamos juntos antes de activarlo para asegurarnos de que todo funcione perfecto." },
        { n:"04", icon:"🚀", t:"Activamos y monitoreamos", b:"Lo lanzamos y te damos acceso a un panel donde puedes ver todas las conversaciones. El primer mes lo ajustamos en tiempo real según cómo responden tus clientes." },
      ].map(p => (
        <div class="kb-paso">
          <div class="kb-paso__node">{p.icon}</div>
          <div class="kb-paso__num kt-mono">{p.n}</div>
          <h3 class="kb-paso__title">{p.t}</h3>
          <p class="kb-paso__body">{p.b}</p>
        </div>
      ))}
    </div>
  </div>
</section>


<!-- ═══════════════════ PRECIOS KREATUBOT ═══════════════════ -->
<section class="kb-planes">
  <div class="kt-shell">
    <div class="kt-section__head">
      <div class="kt-eyebrow"><span class="kt-eyebrow__dot"></span><span class="kt-mono">03 / Precios</span></div>
      <h2 class="kb-section__title">Planes <em class="kb-italic">KreatuBot</em>.</h2>
      <p class="kt-section__lede">KreatuBot es un servicio independiente. Puedes contratarlo solo o combinarlo con tu página web — tú decides.</p>
    </div>

    <div class="kb-planes__grid">

      <div class="kb-plan">
        <div class="kb-plan__head">
          <span class="kb-plan__name">KreatuBot Starter</span>
          <span class="kb-plan__price">$1,499<small>.99</small></span>
          <span class="kb-plan__sub kt-mono">MXN + IVA · pago único + $349/mes</span>
        </div>
        <ul class="kb-plan__feats">
          <li><span class="kb-check kb-check--bot">✓</span> <strong>Agente de atención al cliente</strong></li>
          <li><span class="kb-check kb-check--bot">✓</span> Respuestas automáticas 24/7 por WhatsApp</li>
          <li><span class="kb-check kb-check--bot">✓</span> FAQs entrenadas con tu negocio</li>
          <li><span class="kb-check kb-check--bot">✓</span> Escalación a humano cuando se necesita</li>
          <li><span class="kb-check">✓</span> Configuración e integración incluida</li>
          <li><span class="kb-check">✓</span> Soporte 30 días</li>
        </ul>
        <a href="#contacto" class="kt-btn kb-plan__btn">Quiero KreatuBot Starter</a>
      </div>

      <div class="kb-plan kb-plan--hi">
        <div class="kb-plan__ribbon kt-mono">★ Más solicitado</div>
        <div class="kb-plan__head">
          <span class="kb-plan__name">KreatuBot Pro</span>
          <span class="kb-plan__price">$2,999<small>.99</small></span>
          <span class="kb-plan__sub kt-mono">MXN + IVA · pago único + $499/mes</span>
        </div>
        <ul class="kb-plan__feats">
          <li><span class="kb-check kb-check--bot">✓</span> <strong>3 agentes activos</strong> — atención, ventas y follow-up</li>
          <li><span class="kb-check kb-check--bot">✓</span> Agente de ventas automatizado</li>
          <li><span class="kb-check kb-check--bot">✓</span> Seguimiento automático de leads</li>
          <li><span class="kb-check kb-check--bot">✓</span> Secuencias de mensajes personalizadas</li>
          <li><span class="kb-check kb-check--bot">✓</span> Recordatorios de citas y pagos</li>
          <li><span class="kb-check kb-check--bot">✓</span> Panel de conversaciones en tiempo real</li>
          <li><span class="kb-check kb-check--bot">✓</span> Reportes mensuales de conversión</li>
          <li><span class="kb-check">✓</span> Configuración e integración incluida</li>
          <li><span class="kb-check">✓</span> Capacitación para tu equipo</li>
          <li><span class="kb-check">✓</span> Soporte prioritario 60 días</li>
        </ul>
        <a href="#contacto" class="kt-btn kb-plan__btn kb-plan__btn--hi">Quiero KreatuBot Pro</a>
      </div>

    </div>

    <div class="kb-planes__note kt-mono">
      // ¿Ya tienes página web con nosotros? Pregunta por precio especial al combinar servicios.
    </div>
  </div>
</section>


<!-- ═══════════════════ FAQ ═══════════════════ -->
<section class="kb-faq">
  <div class="kt-shell kb-faq__shell">
    <div class="kb-faq__intro">
      <div class="kt-eyebrow"><span class="kt-eyebrow__dot"></span><span class="kt-mono">04 / FAQ</span></div>
      <h2 class="kb-section__title">Lo que nos <em class="kb-italic">preguntan</em>.</h2>
      <a href="#contacto" class="kt-btn kb-btn--ghost kb-btn--lg" style="margin-top:16px">Hablar con nosotros →</a>
    </div>
    <div class="kb-faq__list">
      {[
        { q:"¿El bot suena robótico?",                   a:"No. Lo entrenamos con el tono de tu negocio — puede ser formal, amigable o casual según tu marca. La mayoría de los clientes no notan que están hablando con un bot hasta que se lo dices." },
        { q:"¿Funciona con mi WhatsApp actual?",          a:"Sí, se integra con WhatsApp Business API. Si no tienes cuenta Business, te ayudamos a configurarla. También funciona con números nuevos." },
        { q:"¿Qué pasa si el cliente pregunta algo que el bot no sabe?", a:"KreatuBot tiene un flujo de escalación — cuando detecta una pregunta fuera de su alcance, avisa al equipo humano y transfiere la conversación de manera transparente." },
        { q:"¿Cuánto tarda en aprender mi negocio?",     a:"La configuración inicial toma entre 3 y 5 días. El primer mes lo monitoreamos y afinamos en tiempo real según las conversaciones reales de tus clientes." },
        { q:"¿Puedo ver las conversaciones?",             a:"Sí. Tienes acceso a un panel donde puedes leer todas las conversaciones, ver métricas y ajustar respuestas cuando quieras." },
      ].map((it, i) => (
        <button class="kb-faqItem" data-faq={i}>
          <span class="kb-faqItem__num kt-mono">{String(i+1).padStart(2,"0")}</span>
          <span class="kb-faqItem__q">{it.q}</span>
          <span class="kb-faqItem__icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="kb-faqItem__a">{it.a}</span>
        </button>
      ))}
    </div>
  </div>
</section>


<!-- ═══════════════════ CONTACTO ═══════════════════ -->
<Contact />

</Layout>


<!-- ═══════════════════ SCRIPTS ═══════════════════ -->
<script>
  // Chat demo simulado
  const chatData: Record<string, { label: string; bot1: string; bot2: string }> = {
    precios: {
      label: "💰 Ver precios",
      bot1: "¡Claro! 😊 KreatuBot tiene dos planes independientes:\n\n⚡ <strong>KreatuBot Starter — $1,499.99 + IVA</strong>\nAgente de atención al cliente 24/7 por WhatsApp, responde FAQs y escala a humano cuando lo necesita. Mantenimiento desde $349/mes.\n\n🚀 <strong>KreatuBot Pro — $2,999.99 + IVA</strong>\n3 agentes activos: atención, ventas y seguimiento de leads. Panel de conversaciones, reportes mensuales y capacitación incluida. Desde $499/mes.",
      bot2: "¿Te gustaría que Victor Rubio te explique cuál se adapta mejor a tu negocio? 👇"
    },
    cita: {
      label: "📅 Agendar cita",
      bot1: "¡Con gusto! 📅 Para agendar una videollamada sin compromiso de 20 minutos con Victor Rubio, solo necesito que nos contactes directamente — él se adapta a tu horario.",
      bot2: "En la llamada te mostramos exactamente cómo quedaría KreatuBot funcionando para <em>tu</em> negocio específico. 👇"
    },
    info: {
      label: "ℹ️ Más información",
      bot1: "KreatuBot es un sistema de agentes de IA que trabaja por ti las 24 horas:\n\n🤖 <strong>Agente de atención</strong> — responde preguntas y resuelve dudas al instante\n💼 <strong>Agente de ventas</strong> — califica leads y guía al cliente hasta cerrar\n📊 <strong>Seguimiento de leads</strong> — nadie se queda sin respuesta, nunca",
      bot2: "Se integra a tu WhatsApp Business y lo entrenamos con la información de tu negocio. ¿Hablamos? 👇"
    }
  };

  function chatReply(type: string) {
    const chatBody = document.getElementById('chat-body');
    const chatOpts = document.getElementById('chat-opts');
    if (!chatBody || !chatOpts) return;

    const res = chatData[type];
    if (!res) return;

    chatOpts.style.display = 'none';

    // Mensaje del usuario
    const userMsg = document.createElement('div');
    userMsg.className = 'kb-chat__msg kb-chat__msg--user';
    userMsg.innerHTML = `<p>${res.label}</p>`;
    chatBody.appendChild(userMsg);
    chatBody.scrollTop = chatBody.scrollHeight;

    // Typing 1
    setTimeout(() => {
      const t1 = document.createElement('div');
      t1.className = 'kb-chat__typing';
      t1.innerHTML = '<span></span><span></span><span></span>';
      chatBody.appendChild(t1);
      chatBody.scrollTop = chatBody.scrollHeight;

      setTimeout(() => {
        t1.remove();
        const b1 = document.createElement('div');
        b1.className = 'kb-chat__msg kb-chat__msg--bot';
        b1.innerHTML = `<p>${res.bot1.replace(/\n/g, '<br/>')}</p><span class="kb-chat__time">Ahora mismo</span>`;
        chatBody.appendChild(b1);
        chatBody.scrollTop = chatBody.scrollHeight;

        // Typing 2
        setTimeout(() => {
          const t2 = document.createElement('div');
          t2.className = 'kb-chat__typing';
          t2.innerHTML = '<span></span><span></span><span></span>';
          chatBody.appendChild(t2);
          chatBody.scrollTop = chatBody.scrollHeight;

          setTimeout(() => {
            t2.remove();
            const b2 = document.createElement('div');
            b2.className = 'kb-chat__msg kb-chat__msg--bot';
            b2.innerHTML = `<p>${res.bot2}</p><span class="kb-chat__time">Ahora mismo</span>`;
            chatBody.appendChild(b2);
            chatBody.scrollTop = chatBody.scrollHeight;

            // Botones de acción
            const actions = document.createElement('div');
            actions.className = 'kb-chat__options';
            actions.innerHTML = `
              <a href="#contacto" class="kb-chat__opt kb-chat__opt--cta" onclick="smoothContact(event)">✉️ Contactar a Victor Rubio</a>
              <button class="kb-chat__opt" onclick="resetChat()">↩ Volver</button>
            `;
            chatBody.after(actions);
            chatBody.scrollTop = chatBody.scrollHeight;
          }, 1200);
        }, 800);
      }, 1400);
    }, 400);
  }

  function smoothContact(e: Event) {
    e.preventDefault();
    const contact = document.getElementById('contacto');
    if (contact) contact.scrollIntoView({ behavior: 'smooth' });
  }

  function resetChat() {
    const chatBody = document.getElementById('chat-body');
    const chatOpts = document.getElementById('chat-opts');
    if (!chatBody || !chatOpts) return;

    chatBody.querySelectorAll('.kb-chat__msg--user, .kb-chat__msg--bot:not(:first-child), .kb-chat__typing').forEach(el => el.remove());

    const extra = chatOpts.nextElementSibling;
    if (extra && extra.classList.contains('kb-chat__options')) extra.remove();

    chatOpts.style.display = 'flex';
    chatBody.scrollTop = 0;
  }

  // FAQ accordion
  document.querySelectorAll('.kb-faqItem').forEach(btn => {
    btn.addEventListener('click', () => {
      const isOpen = btn.classList.contains('is-open');
      document.querySelectorAll('.kb-faqItem').forEach(b => b.classList.remove('is-open'));
      if (!isOpen) btn.classList.add('is-open');
    });
  });

  // Hacer las funciones accesibles globalmente
  (window as any).chatReply = chatReply;
  (window as any).resetChat = resetChat;
</script>


<!-- ═══════════════════ ESTILOS ═══════════════════ -->
<style>
  /* ── Variables de KreatuBot ── */
  :root {
    --kb-dark:    #0a0f0d;
    --kb-dark-2:  #111a15;
    --kb-bot:     #00D4FF;
    --kb-bot-dim: rgba(0,212,255,0.12);
    --kb-green:   #1D9E75;
    --kb-green-d: #0F6E56;
    --kb-glow:    rgba(0,212,255,0.15);
  }

  /* ── HERO ── */
  .kb-hero { position:relative; padding:100px 0 0; overflow:hidden; background:var(--kb-dark); }
  .kb-hero__bg { position:absolute; inset:0; pointer-events:none; }
  .kb-hero__grid { position:absolute; inset:0; background-image:linear-gradient(to right,rgba(0,212,255,.06) 1px,transparent 1px),linear-gradient(to bottom,rgba(0,212,255,.06) 1px,transparent 1px); background-size:56px 56px; mask-image:radial-gradient(ellipse 80% 60% at 50% 30%,black,transparent 80%); }
  .kb-hero__glow { position:absolute; left:30%; top:-20%; width:900px; height:700px; background:radial-gradient(ellipse,rgba(0,212,255,.12),transparent 65%); filter:blur(60px); }
  .kb-hero__glow--2 { left:60%; top:20%; background:radial-gradient(ellipse,rgba(29,158,117,.15),transparent 65%); }
  .kb-hero__inner { position:relative; z-index:1; display:grid; grid-template-columns:1fr 1fr; gap:52px; align-items:start; padding-top:40px; padding-bottom:100px; }
  @media(max-width:1020px){ .kb-hero__inner { grid-template-columns:1fr; } }
  .kb-hero__copy { max-width:580px; }

  .kb-hero__title { font-family:'Instrument Serif',serif; font-weight:400; font-size:clamp(36px,5vw,72px); line-height:1; letter-spacing:-.02em; margin:18px 0 22px; color:#fff; }
