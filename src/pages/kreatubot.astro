/* ── ROI ── */
function ROI() {
  const [leads, setLeads] = useState(120);
  const [ticket, setTicket] = useState(1200);
  const [hours, setHours] = useState(10);
  const baseline = useMemo(()=>Math.round(leads*0.18*ticket),[leads,ticket]);
  const withBot  = useMemo(()=>Math.round(leads*0.36*ticket),[leads,ticket]);
  const lift = withBot - baseline;
  const savedTime = hours*4*4;
  return (
    <section className="roi" id="roi">
      <div className="shell">
        <div className="roi__grid">
          <div>
            <div className="eyebrow"><span className="dot"></span><span>04 / calculadora</span></div>
            <h2 className="section-title serif">¿Cuánto te <em className="italic">deja</em> KreatuBot?</h2>
            <p className="section-lede">Mueve las palancas. Calculamos un escenario conservador asumiendo que sin bot conviertes ~18 % y con KreatuBot subes a ~36 % (promedio de nuestros clientes a los 60 días).</p>
          </div>
          <div className="roi__panel">
            <div className="roi__row">
              <div className="roi__row-head"><span>Leads / mes en WhatsApp</span><b>{leads}</b></div>
              <input type="range" min="20" max="800" step="10" value={leads} onChange={e=>setLeads(+e.target.value)}/>
            </div>
            <div className="roi__row">
              <div className="roi__row-head"><span>Ticket promedio (MXN)</span><b>${ticket.toLocaleString()}</b></div>
              <input type="range" min="200" max="20000" step="100" value={ticket} onChange={e=>setTicket(+e.target.value)}/>
            </div>
            <div className="roi__row">
              <div className="roi__row-head"><span>Horas/día que tu equipo contesta</span><b>{hours} h</b></div>
              <input type="range" min="1" max="16" step="1" value={hours} onChange={e=>setHours(+e.target.value)}/>
            </div>
            <div className="roi__result">
              <div><div className="label">+ ingresos / mes</div><div className="value up">${lift.toLocaleString()}</div></div>
              <div><div className="label">horas devueltas / mes</div><div className="value">{savedTime} h</div></div>
            </div>
            <p className="roi__disclaimer">// estimación basada en uplift promedio de clientes activos · no es promesa de resultado</p>
          </div>
        </div>
      </div>
    </section>
  );
}

