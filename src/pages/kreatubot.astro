.plan__ribbon { position: absolute; top: -12px; left: 24px; background: var(--kb-bot); color: var(--kb-dark); padding: 4px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; font-family: 'JetBrains Mono',monospace; }
.plan__name { font-family: 'Instrument Serif',serif; font-size: 26px; color: #fff; }
.plan__price { font-family: 'Instrument Serif',serif; font-size: 52px; color: #fff; line-height: 1; font-weight: 400; }
.plan__price small { font-size: 18px; color: var(--kb-text-3); }
.plan__sub { font-family: 'JetBrains Mono',monospace; font-size: 11.5px; color: var(--kb-text-3); }
.plan__feats { list-style: none; padding: 0; margin: 4px 0 0; display: flex; flex-direction: column; gap: 11px; flex: 1; }
.plan__feats li { font-size: 13.5px; color: var(--kb-text-2); display: flex; gap: 10px; align-items: flex-start; }
.plan__feats li::before { content:"✓"; color:var(--kb-bot); font-weight:700; flex-shrink:0; }
.plan__feats li.muted { color: var(--kb-text-3); }
.plan__feats li.muted::before { content:"—"; color:var(--kb-text-3); }
.plan__btn { display: block; text-align: center; padding: 13px; border-radius: 999px; border: 1px solid rgba(255,255,255,.18); color: #fff; font-weight: 600; font-size: 14.5px; cursor: pointer; transition: all .2s; background: transparent; }
.plan__btn:hover { background: rgba(255,255,255,.05); }
.plan__btn--hi { background: var(--kb-bot); color: var(--kb-dark); border-color: var(--kb-bot); }
.plan__btn--hi:hover { background: #5ee4ff; }
.pricing__note { text-align: center; margin-top: 28px; font-family: 'JetBrains Mono',monospace; font-size: 12px; color: var(--kb-text-3); }
