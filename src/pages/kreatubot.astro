---
// kreatubot.astro — Implementación del diseño KreatuBot Landing
// React+Babel embebidos via CDN para los componentes interactivos
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>KreatuBot — Agentes de IA para WhatsApp · Atiende, vende y da seguimiento 24/7</title>
  <meta name="description" content="Agentes de IA en WhatsApp que atienden, venden y dan seguimiento por ti. Para médicos, odontólogos, e-commerce, estéticas, restaurantes y bienes raíces. 24/7." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style is:global>
/* ───────── KreatuBot Landing — estilos ───────── */
:root {
  --kb-dark:    #0a0f0d;
  --kb-dark-2:  #0f1714;
  --kb-dark-3:  #131e19;
  --kb-card:    #111a15;
  --kb-line:    rgba(255,255,255,.07);
  --kb-line-2:  rgba(255,255,255,.12);
  --kb-text:    #f3f5f3;
  --kb-text-2:  rgba(243,245,243,.66);
  --kb-text-3:  rgba(243,245,243,.42);
  --kb-bot:     #00D4FF;
  --kb-bot-dim: rgba(0,212,255,.12);
  --kb-green:   #1D9E75;
  --kb-green-2: #25C48B;
  --kb-warn:    #F5A524;
  --shell-w:    1240px;
}
*, *::before, *::after { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: var(--kb-dark); color: var(--kb-text); font-family: 'Geist','Inter',-apple-system,BlinkMacSystemFont,sans-serif; -webkit-font-smoothing: antialiased; }
img, svg { display: block; max-width: 100%; }
button { font-family: inherit; }
a { color: inherit; text-decoration: none; }
.shell { max-width: var(--shell-w); margin: 0 auto; padding: 0 28px; }
.serif { font-family: 'Instrument Serif','Times New Roman',serif; font-weight: 400; letter-spacing: -.01em; }
.mono  { font-family: 'JetBrains Mono',ui-monospace,monospace; letter-spacing: .02em; }
.italic { font-style: italic; color: var(--kb-bot); }
.eyebrow { display: inline-flex; align-items: center; gap: 10px; font-family: 'JetBrains Mono',monospace; font-size: 12px; color: var(--kb-text-3); letter-spacing: .04em; text-transform: lowercase; }
.eyebrow .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--kb-bot); box-shadow: 0 0 0 4px rgba(0,212,255,.12); }
.eyebrow .sep { color: rgba(255,255,255,.15); }
.section-title { font-size: clamp(34px,4.4vw,56px); line-height: 1.02; margin: 14px 0 18px; color: #fff; }
.section-lede { font-size: 17px; color: var(--kb-text-2); max-width: 640px; line-height: 1.55; margin: 0; }
.btn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 22px; border-radius: 999px; font-weight: 600; font-size: 14.5px; border: 1px solid transparent; cursor: pointer; transition: transform .18s,background .18s,border-color .18s,box-shadow .2s; white-space: nowrap; }
.btn--primary { background: var(--kb-bot); color: var(--kb-dark); box-shadow: 0 12px 30px -10px rgba(0,212,255,.6); }
.btn--primary:hover { background: #5ee4ff; transform: translateY(-1px); }
.btn--wa { background: var(--kb-green); color: #fff; box-shadow: 0 12px 30px -10px rgba(29,158,117,.7); }
.btn--wa:hover { background: var(--kb-green-2); transform: translateY(-1px); }
.btn--ghost { background: transparent; color: #fff; border-color: rgba(255,255,255,.18); }
.btn--ghost:hover { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.3); }
.btn--lg { padding: 15px 26px; font-size: 15px; }
/* NAV */
.nav { position: sticky; top: 0; z-index: 50; background: rgba(10,15,13,.72); backdrop-filter: blur(14px); border-bottom: 1px solid var(--kb-line); }
.nav__inner { display: flex; align-items: center; justify-content: space-between; padding: 14px 28px; max-width: var(--shell-w); margin: 0 auto; }
.nav__logo { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 16px; letter-spacing: -.01em; }
.nav__logo-mark { width: 30px; height: 30px; border-radius: 9px; background: linear-gradient(135deg,var(--kb-green),var(--kb-bot)); display: grid; place-items: center; color: #06110d; font-weight: 800; font-size: 13px; font-family: 'JetBrains Mono',monospace; }
.nav__links { display: flex; align-items: center; gap: 28px; font-size: 14px; color: var(--kb-text-2); }
.nav__links a:hover { color: #fff; }
.nav__cta { display: flex; align-items: center; gap: 10px; }
.nav__back { font-size: 13px; color: var(--kb-text-3); }
.nav__back:hover { color: var(--kb-text); }
@media(max-width:780px){ .nav__links { display:none; } }
/* HERO */
.hero { position: relative; overflow: hidden; background: var(--kb-dark); padding: 64px 0 90px; }
.hero__bg { position: absolute; inset: 0; pointer-events: none; }
.hero__grid { position: absolute; inset: 0; background-image: linear-gradient(to right,rgba(0,212,255,.05) 1px,transparent 1px),linear-gradient(to bottom,rgba(0,212,255,.05) 1px,transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 70% 60% at 50% 20%,black,transparent 75%); }
.hero__glow { position: absolute; left: 20%; top: -10%; width: 900px; height: 700px; background: radial-gradient(ellipse,rgba(0,212,255,.16),transparent 65%); filter: blur(60px); }
.hero__glow--2 { left: 55%; top: 25%; background: radial-gradient(ellipse,rgba(29,158,117,.18),transparent 65%); }
.hero__inner { position: relative; display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
@media(max-width:1020px){ .hero__inner { grid-template-columns:1fr; gap:48px; } }
.hero__title { font-size: clamp(40px,5.4vw,76px); line-height: .98; color: #fff; margin: 18px 0 22px; }
.hero__title .underline { background-image: linear-gradient(180deg,transparent 65%,rgba(0,212,255,.4) 65% 92%,transparent 92%); padding: 0 .08em; }
.hero__lede { font-size: 18px; line-height: 1.55; color: var(--kb-text-2); margin: 0 0 28px; max-width: 540px; }
.hero__lede em { font-family: 'Instrument Serif',serif; font-style: italic; color: var(--kb-bot); font-size: 1.05em; }
.hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 36px; }
.hero__proof { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 28px 36px; }
.hero__proof li { font-size: 13px; color: var(--kb-text-3); }
.hero__proof strong { display: block; font-family: 'Instrument Serif',serif; font-size: 30px; color: #fff; font-weight: 400; line-height: 1; margin-bottom: 6px; }
/* Phone */
.phone-wrap { position: relative; }
.phone { width: 360px; max-width: 100%; margin: 0 auto; background: #1f2c25; border-radius: 38px; padding: 12px; box-shadow: 0 50px 100px -30px rgba(0,0,0,.7),0 0 80px rgba(0,212,255,.08); border: 1px solid rgba(255,255,255,.06); position: relative; }
.phone::before { content:""; position: absolute; top: 22px; left: 50%; transform: translateX(-50%); width: 110px; height: 26px; background: #0a0f0d; border-radius: 14px; z-index: 3; }
.phone__screen { background: transparent; border-radius: 28px; overflow: hidden; height: 620px; display: flex; flex-direction: column; position: relative; }
.phone__statusbar { height: 44px; display: flex; align-items: center; justify-content: space-between; padding: 0 26px; font-size: 13px; font-weight: 600; color: #fff; padding-top: 4px; background: #075E54; }
.phone__statusbar span { display: inline-flex; gap: 4px; align-items: center; }
.wa { flex: 1; display: flex; flex-direction: column; background: #0b1410; background-image: radial-gradient(circle at 25% 18%,rgba(0,212,255,.05),transparent 32%),radial-gradient(circle at 80% 75%,rgba(29,158,117,.08),transparent 38%); }
.wa__header { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: #1f2c25; border-bottom: 1px solid rgba(255,255,255,.05); }
.wa__back { font-size: 18px; color: #fff; }
.wa__avatar { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg,var(--kb-green),var(--kb-bot)); display: grid; place-items: center; font-weight: 700; font-size: 13px; color: #06110d; flex-shrink: 0; }
.wa__name { flex: 1; }
.wa__name b { display: block; font-size: 13px; color: #fff; font-weight: 600; }
.wa__name span { font-size: 11.5px; color: var(--kb-green-2); }
.wa__icons { display: flex; gap: 10px; font-size: 18px; }
.wa__body { flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 6px; }
.wa__body::-webkit-scrollbar { width: 0; }
.wa__input { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: #1f2c25; }
.wa__input-box { flex: 1; background: #2a3b32; border-radius: 22px; padding: 8px 16px; font-size: 13px; color: var(--kb-text-3); }
.wa__send { width: 36px; height: 36px; border-radius: 50%; background: var(--kb-green); display: grid; place-items: center; font-size: 14px; cursor: pointer; flex-shrink: 0; }
.bubble { max-width: 82%; padding: 8px 12px; border-radius: 12px; font-size: 13.5px; line-height: 1.4; position: relative; }
.bubble--bot { background: #1f2c25; color: var(--kb-text); border-radius: 4px 12px 12px 12px; align-self: flex-start; }
.bubble--user { background: #1a5c3e; color: #fff; border-radius: 12px 4px 12px 12px; align-self: flex-end; }
.bubble--system { background: rgba(255,255,255,.06); color: var(--kb-text-3); font-size: 11.5px; border-radius: 8px; padding: 4px 10px; align-self: center; font-family: 'JetBrains Mono',monospace; }
.bubble--card { padding: 0; overflow: hidden; background: #1f2c25; }
.card-img { height: 70px; background: linear-gradient(135deg,rgba(0,212,255,.15),rgba(29,158,117,.15)); display: grid; place-items: center; font-size: 12px; color: var(--kb-text-3); }
.card-body { padding: 8px 12px; }
.card-body b { display: block; font-size: 13px; color: #fff; }
.card-body small { font-size: 11.5px; color: var(--kb-text-3); }
.bubble__meta { display: block; font-size: 10.5px; color: var(--kb-text-3); margin-top: 4px; text-align: right; }
.bubble__check { color: #53bdeb; }
.bubble--quick { display: flex; flex-wrap: wrap; gap: 6px; align-self: flex-start; margin-top: 2px; }
.bubble--quick button { background: rgba(0,212,255,.1); border: 1px solid rgba(0,212,255,.3); color: var(--kb-bot); padding: 6px 12px; border-radius: 999px; font-size: 12.5px; cursor: default; font-family: inherit; }
.typing { display: flex; gap: 4px; align-items: center; padding: 10px 14px; background: #1f2c25; border-radius: 4px 12px 12px 12px; align-self: flex-start; }
.typing span { width: 7px; height: 7px; border-radius: 50%; background: var(--kb-text-3); animation: typ .9s infinite; }
.typing span:nth-child(2){ animation-delay:.2s; }
.typing span:nth-child(3){ animation-delay:.4s; }
@keyframes typ { 0%,60%,100%{transform:translateY(0)} 30%{transform:translateY(-5px)} }
.pulse { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--kb-green); animation: pls 1.5s infinite; }
@keyframes pls { 0%{box-shadow:0 0 0 0 rgba(29,158,117,.6)} 70%{box-shadow:0 0 0 8px transparent} 100%{box-shadow:0 0 0 0 transparent} }
.phone-tag { position: absolute; display: flex; align-items: center; gap: 7px; background: rgba(15,26,20,.88); border: 1px solid rgba(255,255,255,.1); backdrop-filter: blur(8px); border-radius: 999px; padding: 6px 14px; font-size: 12.5px; color: var(--kb-text-2); white-space: nowrap; }
.phone-tag--tl { top: -14px; left: -20px; }
.phone-tag--br { bottom: -14px; right: -20px; }
/* Industries */
.industries { padding: 52px 0 44px; background: var(--kb-dark-2); border-top: 1px solid var(--kb-line); border-bottom: 1px solid var(--kb-line); }
.industries__title { text-align: center; font-size: 13px; color: var(--kb-text-3); margin: 0 0 18px; font-family: 'JetBrains Mono',monospace; letter-spacing: .04em; }
.industries__row { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
.industry { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 12px 20px; border-radius: 16px; border: 1px solid var(--kb-line-2); background: transparent; color: var(--kb-text-2); cursor: pointer; transition: all .2s; }
.industry:hover { border-color: rgba(0,212,255,.35); color: #fff; background: var(--kb-bot-dim); }
.industry.is-active { border-color: var(--kb-bot); background: var(--kb-bot-dim); color: var(--kb-bot); }
.industry__icon { font-size: 22px; }
.industry__name { font-size: 13px; font-weight: 600; }
.industry__sub { font-family: 'JetBrains Mono',monospace; font-size: 10px; color: var(--kb-text-3); }
.industry.is-active .industry__sub { color: rgba(0,212,255,.6); }
/* Demo */
.demo { padding: 110px 0; background: var(--kb-dark); }
.demo__head { text-align: center; max-width: 680px; margin: 0 auto 48px; }
.demo__head .section-lede { margin: 0 auto; }
.demo__grid { display: grid; grid-template-columns: 220px 1fr; gap: 32px; align-items: start; }
@media(max-width:900px){ .demo__grid { grid-template-columns:1fr; } }
.demo__menu { display: flex; flex-direction: column; gap: 8px; }
.demo__btn { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 14px; border: 1px solid var(--kb-line-2); background: transparent; color: var(--kb-text-2); cursor: pointer; text-align: left; transition: all .2s; }
.demo__btn:hover { border-color: rgba(0,212,255,.25); color: #fff; }
.demo__btn.is-active { border-color: var(--kb-bot); background: var(--kb-bot-dim); color: #fff; }
.demo__btn-icon { font-size: 20px; flex-shrink: 0; }
.demo__btn-text { display: flex; flex-direction: column; }
.demo__btn-text b { font-size: 13.5px; }
.demo__btn-text small { font-size: 11px; color: var(--kb-text-3); margin-top: 2px; }
.demo__stage { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; align-items: center; }
@media(max-width:700px){ .demo__stage { grid-template-columns:1fr; } }
.demo__caption h3 { font-family: 'Instrument Serif',serif; font-size: 26px; color: #fff; margin: 8px 0 12px; font-weight: 400; }
.demo__caption p { font-size: 15px; color: var(--kb-text-2); line-height: 1.55; margin: 0 0 18px; }
.demo__controls { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
.demo__pill { background: var(--kb-bot-dim); border: 1px solid rgba(0,212,255,.25); color: var(--kb-bot); padding: 5px 12px; border-radius: 999px; font-size: 12px; font-family: 'JetBrains Mono',monospace; }
.demo__stats { display: flex; gap: 24px; }
.demo__stat b { display: block; font-family: 'Instrument Serif',serif; font-size: 36px; color: var(--kb-bot); font-weight: 400; }
.demo__stat span { font-size: 12px; color: var(--kb-text-3); }
/* Agents */
.agents { padding: 110px 0; background: var(--kb-dark-2); border-top: 1px solid var(--kb-line); }
.agents__head { text-align: center; max-width: 680px; margin: 0 auto 48px; }
.agents__head .section-lede { margin: 0 auto; }
.agents__grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
@media(max-width:900px){ .agents__grid { grid-template-columns:1fr; } }
.agent { background: var(--kb-card); border: 1px solid var(--kb-line); border-radius: 22px; padding: 32px 28px; display: flex; flex-direction: column; gap: 14px; position: relative; }
.agent--hi { background: linear-gradient(160deg,#0d2018,var(--kb-card)); border-color: rgba(0,212,255,.28); box-shadow: 0 0 60px rgba(0,212,255,.07); }
.agent__ribbon { position: absolute; top: -12px; left: 24px; background: var(--kb-bot); color: var(--kb-dark); padding: 4px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; font-family: 'JetBrains Mono',monospace; }
.agent__icon { font-size: 28px; }
.agent__num { font-family: 'JetBrains Mono',monospace; font-size: 11px; color: var(--kb-text-3); }
.agent h3 { font-size: 24px; color: #fff; margin: 0; }
.agent p { font-size: 14.5px; color: var(--kb-text-2); margin: 0; line-height: 1.55; }
.agent ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; flex: 1; }
.agent ul li { font-size: 13.5px; color: var(--kb-text-2); display: flex; gap: 8px; }
.agent ul li::before { content:"✓"; color:var(--kb-bot); font-weight:700; flex-shrink:0; }
.agent__tag { font-family: 'JetBrains Mono',monospace; font-size: 11px; color: var(--kb-text-3); margin-top: auto; }
/* How */
.how { padding: 110px 0; background: var(--kb-dark); border-top: 1px solid var(--kb-line); }
.how__head { text-align: center; max-width: 680px; margin: 0 auto 48px; }
.how__head .section-lede { margin: 0 auto; }
.how__grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 24px; position: relative; padding-top: 70px; }
.how__line { position: absolute; top: 90px; left: 0; right: 0; height: 1px; background: linear-gradient(to right,transparent,rgba(0,212,255,.2) 8%,rgba(0,212,255,.2) 92%,transparent); }
.how__step { position: relative; }
.how__node { position: absolute; top: -56px; left: 0; width: 44px; height: 44px; border-radius: 50%; background: var(--kb-bot-dim); border: 1px solid rgba(0,212,255,.35); display: flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 0 0 6px var(--kb-dark),0 0 0 7px rgba(0,212,255,.1); }
.how__num { font-family: 'JetBrains Mono',monospace; font-size: 12px; color: rgba(0,212,255,.4); margin-bottom: 10px; }
.how__title { font-size: 22px; color: #fff; margin: 0 0 10px; }
.how__body { font-size: 14px; color: var(--kb-text-2); margin: 0; line-height: 1.55; }
@media(max-width:980px){ .how__grid { grid-template-columns:repeat(2,1fr); row-gap:60px; } .how__line { display:none; } }
@media(max-width:560px){ .how__grid { grid-template-columns:1fr; } }
/* ROI */
.roi { padding: 110px 0; background: var(--kb-dark-2); border-top: 1px solid var(--kb-line); }
.roi__grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 64px; align-items: center; }
@media(max-width:980px){ .roi__grid { grid-template-columns:1fr; gap:40px; } }
.roi__panel { background: linear-gradient(160deg,var(--kb-card),#0d2018); border: 1px solid rgba(0,212,255,.18); border-radius: 24px; padding: 32px; }
.roi__row { display: flex; flex-direction: column; gap: 6px; padding: 16px 0; border-bottom: 1px solid var(--kb-line); }
.roi__row:last-of-type { border-bottom: 0; }
.roi__row-head { display: flex; justify-content: space-between; align-items: baseline; font-size: 14px; color: var(--kb-text-2); }
.roi__row-head b { font-family: 'Instrument Serif',serif; font-weight: 400; color: #fff; font-size: 22px; }
.roi input[type=range] { -webkit-appearance: none; width: 100%; height: 4px; background: rgba(255,255,255,.08); border-radius: 4px; outline: none; }
.roi input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 18px; height: 18px; border-radius: 50%; background: var(--kb-bot); cursor: pointer; box-shadow: 0 0 0 4px rgba(0,212,255,.18); }
.roi__result { margin-top: 24px; padding: 22px; border-radius: 16px; background: rgba(0,212,255,.06); border: 1px solid rgba(0,212,255,.25); display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
.roi__result .label { font-family: 'JetBrains Mono',monospace; font-size: 11px; color: var(--kb-text-3); text-transform: uppercase; letter-spacing: .06em; }
.roi__result .value { font-family: 'Instrument Serif',serif; font-size: 38px; color: #fff; line-height: 1; margin-top: 8px; font-weight: 400; }
.roi__result .value.up { color: var(--kb-bot); }
.roi__disclaimer { margin-top: 16px; font-family: 'JetBrains Mono',monospace; font-size: 11px; color: var(--kb-text-3); }
/* Testimonials */
.testi { padding: 110px 0; background: var(--kb-dark); }
.testi__head { text-align: center; max-width: 680px; margin: 0 auto 50px; }
.testi__head .section-lede { margin: 0 auto; }
.testi__grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
@media(max-width:980px){ .testi__grid { grid-template-columns:1fr; } }
.testi__card { background: var(--kb-card); border: 1px solid var(--kb-line); border-radius: 20px; padding: 28px; display: flex; flex-direction: column; gap: 18px; }
.testi__quote { font-family: 'Instrument Serif',serif; font-size: 22px; color: #fff; line-height: 1.3; font-weight: 400; flex: 1; }
.testi__quote::before { content:"\201C"; font-size: 48px; color: var(--kb-bot); line-height: 0; display: block; margin-bottom: 14px; font-family: 'Instrument Serif',serif; }
.testi__author { display: flex; align-items: center; gap: 12px; }
.testi__avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg,var(--kb-green),var(--kb-bot)); display: grid; place-items: center; font-weight: 700; font-size: 14px; color: #06110d; }
.testi__author b { display: block; font-size: 14px; }
.testi__author span { font-size: 12px; color: var(--kb-text-3); }
.testi__metric { display: flex; gap: 14px; padding-top: 14px; border-top: 1px solid var(--kb-line); font-family: 'JetBrains Mono',monospace; font-size: 11.5px; color: var(--kb-text-3); }
.testi__metric b { color: var(--kb-bot); }
/* Pricing */
.pricing { padding: 110px 0; background: var(--kb-dark-2); border-top: 1px solid var(--kb-line); }
.pricing__head { text-align: center; max-width: 680px; margin: 0 auto 48px; }
.pricing__head .section-lede { margin: 0 auto; }
.pricing__grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 18px; align-items: stretch; }
@media(max-width:980px){ .pricing__grid { grid-template-columns:1fr; } }
.plan { background: var(--kb-card); border: 1px solid var(--kb-line); border-radius: 22px; padding: 32px 28px; display: flex; flex-direction: column; gap: 22px; position: relative; }
