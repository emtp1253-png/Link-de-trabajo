/* ── ChatStream component ── */
function ChatStream({ industry, autoPlay=true, speed=1 }) {
  const [visible, setVisible] = useState(0);
  const [typing, setTyping] = useState(false);
  const bodyRef = useRef(null);
  const timerRef = useRef([]);

  useEffect(() => {
    timerRef.current.forEach(clearTimeout); timerRef.current = [];
    setVisible(0); setTyping(false);
    if (!autoPlay) return;
    let acc = 400;
    industry.script.forEach((msg, i) => {
      const isBot = msg.from==="bot"||msg.from==="bot-card"||msg.from==="quick";
      const typingDelay = isBot && msg.from!=="quick" ? 700/speed : 0;
      if (typingDelay) {
        acc += 350/speed;
        timerRef.current.push(setTimeout(()=>setTyping(true), acc));
        acc += typingDelay;
        timerRef.current.push(setTimeout(()=>setTyping(false), acc));
      }
      acc += (msg.from==="user" ? 700 : 400)/speed;
      timerRef.current.push(setTimeout(()=>setVisible(i+1), acc));
    });
    return ()=>timerRef.current.forEach(clearTimeout);
  }, [industry.id, autoPlay, speed]);

  useEffect(()=>{ if(bodyRef.current) bodyRef.current.scrollTop=bodyRef.current.scrollHeight; },[visible,typing]);

  return (
    <div className="phone-wrap">
      <div className="phone">
        <div className="phone__screen">
          <div className="phone__statusbar">
            <span>9:41</span>
            <span><span style={{opacity:.9}}>●●●●</span><span style={{marginLeft:8}}>📶</span><span style={{marginLeft:6}}>🔋</span></span>
          </div>
          <div className="wa">
            <div className="wa__header">
              <span className="wa__back">‹</span>
              <span className="wa__avatar">{industry.avatar}</span>
              <span className="wa__name"><b>{industry.bizName}</b><span>en línea · responde en segundos</span></span>
              <span className="wa__icons"><span>📞</span><span>⋮</span></span>
            </div>
            <div className="wa__body" ref={bodyRef}>
              <div className="bubble bubble--system">Hoy · WhatsApp Business · cifrado</div>
              {industry.script.slice(0,visible).map((m,i)=>{
                if(m.from==="user") return <div key={i} className="bubble bubble--user"><span dangerouslySetInnerHTML={{__html:m.text}}/><span className="bubble__meta">9:4{i} <span className="bubble__check">✓✓</span></span></div>;
                if(m.from==="bot") return <div key={i} className="bubble bubble--bot"><span dangerouslySetInnerHTML={{__html:m.text}}/><span className="bubble__meta">9:4{i}</span></div>;
                if(m.from==="bot-card") return <div key={i} className="bubble bubble--bot bubble--card"><div className="card-img">[ imagen / ficha ]</div><div className="card-body"><b>{m.title}</b><small>{m.sub}</small></div></div>;
                if(m.from==="quick") return <div key={i} className="bubble--quick">{m.options.map((opt,j)=><button key={j}>{opt}</button>)}</div>;
                if(m.from==="system") return <div key={i} className="bubble bubble--system">{m.text}</div>;
                return null;
              })}
              {typing && <div className="typing"><span/><span/><span/></div>}
            </div>
            <div className="wa__input">
              <div className="wa__input-box">Escribe un mensaje…</div>
              <div className="wa__send">➤</div>
            </div>
          </div>
        </div>
      </div>
      <div className="phone-tag phone-tag--tl"><span className="pulse"></span><span>Atendiendo · <b>14 chats</b></span></div>
      <div className="phone-tag phone-tag--br"><span>⚡</span><span>Respuesta en <b>1.4 s</b></span></div>
    </div>
  );
}

